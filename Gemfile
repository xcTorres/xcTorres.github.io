source "https://rubygems.org"

# Pinned to Jekyll 3.x: jekyll-gallery-generator requires jekyll ~> 3.8,
# and GitHub Pages itself still builds with Jekyll 3.9.
gem "jekyll", "~> 3.9.5"

group :jekyll_plugins do
  gem "jekyll-paginate", "~> 1.1"
  gem "jekyll-gallery-generator", "~> 1.2"
end

# Ruby 3.x no longer ships these as default gems.
gem "webrick", "~> 1.8"
gem "csv", "~> 3.3"
gem "base64", "~> 0.2"
gem "bigdecimal", "~> 3.1"
gem "logger", "~> 1.6"
gem "observer", "~> 0.1"
gem "ostruct", "~> 0.6"
gem "kramdown-parser-gfm", "~> 1.1"

# Faster incremental rebuilds on macOS.
gem "ffi", "~> 1.17"
